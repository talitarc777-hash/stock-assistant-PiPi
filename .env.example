# App settings
APP_NAME=Stock Assistant API
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# Production runtime state belongs outside the Git checkout so deployments
# cannot replace it. Relative PROFILE_DB_PATH values are stored under this dir.
PERSISTENT_DATA_DIR=/home/pi/.local/share/stock-assistant
PROFILE_DB_PATH=data/user_profiles.db
RESEARCH_DATA_DIR=data/research
RESEARCH_MODELS_DIR=data/models
# Virtual account values are USD. The fixed HKD 50 trade fee is converted
# using this configurable HKD-per-USD rate (default: 50 / 7.8 = USD 6.41).
HKD_PER_USD_RATE=7.8

# Browser CORS origins allowed to call the API.
# Cloudflare Pages preview URLs like https://1b001fa6.stock-assistant-pipi.pages.dev
# are allowed by the app default regex. Add your custom frontend domain here.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cowbox.dpdns.org
CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?stock-assistant-pipi\.pages\.dev$

# Optional defaults for future analysis features
DEFAULT_TICKERS=VOO,SPY,QQQ,AAPL,MSFT,NVDA

# Discord bot settings
DISCORD_BOT_TOKEN=
# If the bot runs on the same Raspberry Pi as the API, keep this local URL.
BACKEND_BASE_URL=http://127.0.0.1:8000
COMMAND_PREFIX=!
ALLOWED_CHANNEL_IDS=
WATCHLIST_TICKERS=VOO,SPY,QQQ,AAPL,MSFT,NVDA
REPLY_LANGUAGE=zh

# Discord real-market alerts
DISCORD_WEBHOOK_URL=
REAL_MARKET_DISCORD_ALERT_ENABLED=true
REAL_MARKET_ALERT_WINDOW_MINUTES=15
REAL_MARKET_SUDDEN_MOVE_THRESHOLD_PCT=10.0
REAL_MARKET_LARGE_VALUE_THRESHOLD=10000000
REAL_MARKET_VOLUME_SPIKE_MULTIPLIER=3
REAL_MARKET_PRICE_MOVE_THRESHOLD_PCT=1.5
REAL_MARKET_MIN_WINDOW_VOLUME=100000
REAL_MARKET_ALERT_TICKER_LIMIT=40
USER_SETTINGS_PATH=data/discord_user_settings.json
