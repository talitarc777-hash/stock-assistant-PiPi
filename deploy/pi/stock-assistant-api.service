[Unit]
Description=Stock Assistant FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/stock-assistant-PiPi
EnvironmentFile=/home/pi/stock-assistant-PiPi/.env
ExecStart=/home/pi/stock-assistant-PiPi/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
